{
    "version": "0.2.0",
    "configurations": [
        // Not meant to run on its own; use "Run", which runs the "run: prepare" task first.
        {
            "name": "Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": ["main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
            "cwd": "${workspaceFolder}/api",
            "python": "${workspaceFolder}/api/.venv/bin/python",
            "windows": {
                "python": "${workspaceFolder}/api/.venv/Scripts/python.exe"
            },
            "justMyCode": true,
            "presentation": { "hidden": true }
        },
        // Not meant to run on its own; use "Run", which runs the "run: prepare" task first.
        {
            "name": "Frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "pnpm run dev",
            "cwd": "${workspaceFolder}/web",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "localhost:([0-9]+)",
                "uriFormat": "http://localhost:%s"
            },
            "presentation": { "hidden": true }
        },
        {
            "name": "Run in Docker",
            "type": "node-terminal",
            "request": "launch",
            "command": "docker run --rm -p 8000:8000 hello",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "docker: build",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Uvicorn running on http://0\\.0\\.0\\.0:([0-9]+)",
                "uriFormat": "http://localhost:%s"
            }
        }
    ],
    "compounds": [
        {
            "name": "Run",
            "configurations": ["Backend", "Frontend"],
            "preLaunchTask": "run: prepare",
            "stopAll": true
        }
    ]
}
