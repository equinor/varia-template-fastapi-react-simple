{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "web: install",
            "type": "shell",
            "command": "pnpm install",
            "options": { "cwd": "${workspaceFolder}/web" },
            "problemMatcher": []
        },
        {
            "label": "web: dev",
            "type": "shell",
            "command": "pnpm run dev",
            "options": { "cwd": "${workspaceFolder}/web" },
            "dependsOn": ["web: install"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": { "regexp": "^$" },
                "background": {
                    "beginsPattern": "VITE",
                    "endsPattern": "ready in"
                }
            }
        },
        {
            "label": "web: stop dev",
            "type": "shell",
            "command": "echo ${input:terminateWebDev}",
            "problemMatcher": []
        },
        {
            "label": "api: uv sync",
            "type": "shell",
            "command": "uv sync",
            "options": { "cwd": "${workspaceFolder}/api" },
            "problemMatcher": []
        },
        {
            "label": "docker: build",
            "type": "shell",
            "command": "docker build -t hello .",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "terminateWebDev",
            "type": "command",
            "command": "workbench.action.tasks.terminate",
            "args": "web: dev"
        }
    ]
}
